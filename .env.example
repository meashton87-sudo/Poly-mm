# --- Chain -----------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA

# Seconds between polls for new blocks / logs.
POLL_INTERVAL=3.0
# Where to start scanning. Empty = (latest block - LOOKBACK_BLOCKS).
START_BLOCK=
LOOKBACK_BLOCKS=5000
# Max block span per eth_getLogs request (public RPCs cap this).
MAX_BLOCK_RANGE=2000

# Comma-separated "quote" tokens (e.g. WETH, USDC on Robinhood Chain).
# A pool pairing a quote token with something else treats the other side as
# the new memecoin, and liquidity/price are measured in the quote token.
# If unset, the bot can't measure liquidity in meaningful units and the
# MIN_LIQUIDITY gate will block buys (unless MIN_LIQUIDITY=0).
QUOTE_TOKENS=

# --- Risk thresholds -------------------------------------------------------
# Minimum quote-token reserve held by the pool (in whole quote tokens).
MIN_LIQUIDITY=1.0
# Minimum decision-engine confidence (0..1) required to act on "buy".
MIN_CONFIDENCE=0.7
# Maximum heuristic risk score (0..1) allowed for a buy.
MAX_RISK_SCORE=0.5

# --- Decision engine -------------------------------------------------------
# "module.path:function" implementing decide(state: dict) -> dict.
# Empty = built-in stub (always "hold").
DECISION_ENGINE=

# --- Paper trading ---------------------------------------------------------
# Notional size per simulated buy, in quote-token units.
PAPER_TRADE_SIZE=0.1
# JSONL file where simulated positions/actions are appended.
PAPER_LOG_PATH=data/paper_trades.jsonl
# Seconds between mark-to-market price refreshes for open positions.
MARK_INTERVAL=15

# New pools are usually created before they're initialized/funded. Pools
# with no price or zero liquidity are re-evaluated after RECHECK_DELAY
# seconds, up to RECHECK_ATTEMPTS more times.
RECHECK_DELAY=20
RECHECK_ATTEMPTS=3

# Seconds after a pool's creation block to wait before the first decision,
# so the engine can see early trading (momentum / buy pressure). 0 = decide
# immediately. Pools older than this at detection are evaluated right away.
OBSERVE_DELAY=0
